# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed — only .env.example is tracked in git.

# Base URL for your backend API
EXPO_PUBLIC_API_URL=""

# API request timeout in ms
EXPO_PUBLIC_API_TIMEOUT=15000

# Environment name — used for conditional logging / analytics
EXPO_PUBLIC_ENV=development

# Any public keys (Stripe publishable key, analytics key, etc.)
# Rule of thumb: EXPO_PUBLIC_* is bundled into the app and visible to anyone
# who inspects the app bundle. NEVER put secret keys, private API keys, or
# anything sensitive in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx